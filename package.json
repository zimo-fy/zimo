{
  "name": "zimo",
  "version": "0.1.0",
  "private": true,
  "description": "Zimo AI Agent desktop application",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "set ZIMO_LOG_LLM_PAYLOADS=1&& set ZIMO_LOG_MODEL_CATALOG=1&& pnpm --filter @zimo/desktop dev",
    "dev:mac": "ZIMO_LOG_LLM_PAYLOADS=1 ZIMO_LOG_MODEL_CATALOG=1 pnpm --filter @zimo/desktop dev",
    "dev:website": "pnpm --filter @zimo/website dev",
    "build": "pnpm --filter @zimo/desktop build",
    "build:website": "pnpm --filter @zimo/website build",
    "package:dir": "pnpm --filter @zimo/desktop package:dir",
    "package:mac": "pnpm --filter @zimo/desktop package:mac",
    "package:verify:bytecode": "pnpm --filter @zimo/desktop package:verify:bytecode",
    "package:verify:mac": "node scripts/verify-packaged-mac.mjs",
    "package:win": "pnpm --filter @zimo/desktop package:win",
    "package:verify:win": "node scripts/verify-packaged-windows.mjs",
    "preview": "pnpm --filter @zimo/desktop preview",
    "preview:website": "pnpm --filter @zimo/website preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "onnxruntime-node",
      "sharp"
    ]
  }
}
