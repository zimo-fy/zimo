{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "workflow.search-policy",
  "description": "联网检索强制策略：与 SKILL.md、references/01-core/section-3-workflow.md 对齐",
  "version": "1.0.0",
  "mandatoryWebSearchStages": ["S0", "S1", "S2", "S2.5", "S3", "S5"],
  "chapterWriting": {
    "description": "每一章进入成文前至少完成一轮主题相关检索并记录检索意图",
    "minQueriesPerChapter": 2,
    "notes": "由宿主（CodeBuddy / WorkBuddy 等）执行 WebSearch/WebFetch；编排层应记录每章检索次数以供门禁校验"
  },
  "s0ParallelQueries": {
    "competitorDomestic": 3,
    "competitorOverseas": 3,
    "readerAnalysis": 4,
    "monetization": 4
  },
  "qualityGate": {
    "minConvertedScore": 7.5,
    "minRawScore": 15,
    "minBLayerScore": 4,
    "aiContrastMax": 8,
    "aiAdverbMax": 12,
    "minAnchorCoverage": 0.5,
    "minRhythmCv": 0.2
  },
  "searchAccessPolicy": {
    "singlePageTimeoutMs": 15000,
    "blockOnTimeoutInCurrentRun": true,
    "dailyTimeoutLimitPerDomain": 3,
    "blockDaysAfterDailyLimit": 7,
    "persistentBlocklistFile": ".fbs/domain-blocklist.json"
  },
  "writingNotes": {
    "enabled": true,
    "dir": ".fbs/writing-notes",
    "filePattern": "{chapterId}.writing-notes.md"
  }
}
